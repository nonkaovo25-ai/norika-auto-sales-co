# ── Supabase ──────────────────────────────────────────────────
# Supabaseのプロジェクト設定 > API から取得
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── スクレイプ設定 ─────────────────────────────────────────────
# 1キーワードあたり何ページ取得するか（1ページ≒30件）
PAGES_PER_KEYWORD=1

# cronスケジュール（デフォルト: 6時間ごと）
# 例) "0 */6 * * *" = 6時間ごと / "0 8 * * *" = 毎朝8時
CRON_SCHEDULE=0 */6 * * *

# 1回だけ実行して終了したい場合は true（テスト・デバッグ用）
RUN_ONCE=false
